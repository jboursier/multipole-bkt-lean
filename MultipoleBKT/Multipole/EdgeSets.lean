module

public import MultipoleBKT.Cluster.Mobius
public import MultipoleBKT.Cluster.ResummationFormal

/-!
# Edge sets on finite sets of labels and the connected-component expansion

Labels are natural numbers. An edge set on `U ⊆ ℕ` is a finite
set of pairs `(i, j)` with `i < j` in `U` (`pairsOn U`), and `edgeGraph E` is the graph on `ℕ`
it generates; `ConnOn U E` says that `E` connects `U`. For a subpartition `X` (a family of
disjoint blocks), `intraPairs X` are the pairs inside a block and `interPairs X` the pairs
between two blocks (`ℰ^intra(X)`, `ℰ^inter(X)`).

The main result is the **root-component expansion** `sum_powerset_interPairs_root`: grouping the
edge sets `E ⊆ ℰ^inter(X)` by the set of blocks reached from a fixed block `B₀` in
`E ∪ ℰ^intra(X)`,
`∑_{E ⊆ ℰ^inter(X)} ∏_{p ∈ E} g(p)
= ∑_{B₀ ∈ Y ⊆ X} [∑_{E ∈ 𝖤'(Y)} ∏_E g] [∑_{E ⊆ ℰ^inter(X \ Y)} ∏_E g]`,
where `𝖤'(Y)` are the `E ⊆ ℰ^inter(Y)` such that `E ∪ ℰ^intra(Y)` connects `V_Y`. With singleton
blocks this is the usual Mayer expansion grouped by the component of a point
(`sum_powerset_pairsOn_root`). This is the "grouping into connected components" of the proofs of
Corollary 4.61 and of equation (5.165).
-/

@[expose] public section

namespace MultipoleBKT

open Finset

namespace Multipole

open SetPartition

/-! ### Pairs and the graph of an edge set -/

/-- The pairs `(i, j)` with `i < j` of points of `U`. -/
def pairsOn (U : Finset ℕ) : Finset (ℕ × ℕ) :=
  (U ×ˢ U).filter fun p => p.1 < p.2

/-- The graph on `ℕ` generated by an edge set. -/
def edgeGraph (E : Finset (ℕ × ℕ)) : SimpleGraph ℕ :=
  SimpleGraph.fromRel fun i j => (i, j) ∈ E

/-- `E` connects `U`: `U` is nonempty and any two points of `U` are joined in `edgeGraph E`. -/
def ConnOn (U : Finset ℕ) (E : Finset (ℕ × ℕ)) : Prop :=
  U.Nonempty ∧ ∀ i ∈ U, ∀ j ∈ U, (edgeGraph E).Reachable i j

/-- The pairs inside the blocks of `X` (`ℰ^intra(X)`). -/
def intraPairs (X : Finset (Finset ℕ)) : Finset (ℕ × ℕ) :=
  X.biUnion pairsOn

/-- The pairs between two blocks of `X` (`ℰ^inter(X)`). -/
def interPairs (X : Finset (Finset ℕ)) : Finset (ℕ × ℕ) :=
  pairsOn (X.biUnion id) \ intraPairs X

/-- The pairs `i < j` with one point in `C` and the other in `D`. -/
def crossPairs (C D : Finset ℕ) : Finset (ℕ × ℕ) :=
  (C ×ˢ D ∪ D ×ˢ C).filter fun p => p.1 < p.2

theorem mem_pairsOn {U : Finset ℕ} {p : ℕ × ℕ} : p ∈ pairsOn U ↔ p.1 ∈ U ∧ p.2 ∈ U ∧ p.1 < p.2 := by
  simp [pairsOn, and_assoc]

theorem mem_crossPairs {C D : Finset ℕ} {p : ℕ × ℕ} :
    p ∈ crossPairs C D ↔ ((p.1 ∈ C ∧ p.2 ∈ D) ∨ (p.1 ∈ D ∧ p.2 ∈ C)) ∧ p.1 < p.2 := by
  simp [crossPairs]

theorem mem_intraPairs {X : Finset (Finset ℕ)} {p : ℕ × ℕ} :
    p ∈ intraPairs X ↔ ∃ B ∈ X, p ∈ pairsOn B := by
  simp [intraPairs]

theorem mem_interPairs {X : Finset (Finset ℕ)} {p : ℕ × ℕ} :
    p ∈ interPairs X ↔ p ∈ pairsOn (X.biUnion id) ∧ ¬ ∃ B ∈ X, p ∈ pairsOn B := by
  rw [interPairs, Finset.mem_sdiff, mem_intraPairs]

theorem pairsOn_mono {U V : Finset ℕ} (h : U ⊆ V) : pairsOn U ⊆ pairsOn V := by
  intro p hp
  rw [mem_pairsOn] at hp ⊢
  exact ⟨h hp.1, h hp.2.1, hp.2.2⟩

theorem edgeGraph_adj {E : Finset (ℕ × ℕ)} {i j : ℕ} :
    (edgeGraph E).Adj i j ↔ i ≠ j ∧ ((i, j) ∈ E ∨ (j, i) ∈ E) :=
  SimpleGraph.fromRel_adj _ _ _

theorem edgeGraph_mono {E F : Finset (ℕ × ℕ)} (h : E ⊆ F) : edgeGraph E ≤ edgeGraph F := by
  intro i j hij
  rw [edgeGraph_adj] at hij ⊢
  exact ⟨hij.1, hij.2.imp (fun h' => h h') (fun h' => h h')⟩

/-- An adjacency of `edgeGraph E` comes from a pair of `E`, in one of the two orders. -/
theorem exists_mem_of_edgeGraph_adj {E : Finset (ℕ × ℕ)} {i j : ℕ} (h : (edgeGraph E).Adj i j) :
    (i, j) ∈ E ∨ (j, i) ∈ E :=
  (edgeGraph_adj.1 h).2

/-- Endpoints of the edges of an edge set inside `pairsOn U` lie in `U`. -/
theorem mem_of_edgeGraph_adj {E : Finset (ℕ × ℕ)} {U : Finset ℕ} (hE : E ⊆ pairsOn U) {i j : ℕ}
    (h : (edgeGraph E).Adj i j) : i ∈ U ∧ j ∈ U := by
  rcases exists_mem_of_edgeGraph_adj h with h' | h'
  · have := mem_pairsOn.1 (hE h')
    exact ⟨this.1, this.2.1⟩
  · have := mem_pairsOn.1 (hE h')
    exact ⟨this.2.1, this.1⟩

/-- Transfer of reachability along a walk: if every edge of `G` leaving a vertex reachable from `a`
is an edge of `G'`, then reachability from `a` in `G` implies reachability in `G'`. -/
theorem reachable_of_forall_adj_of_reachable {G G' : SimpleGraph ℕ} {a : ℕ}
    (h : ∀ u v, G.Reachable a u → G.Adj u v → G'.Adj u v) {i : ℕ} (hi : G.Reachable a i) :
    G'.Reachable a i := by
  obtain ⟨w₀⟩ := hi
  suffices h' : ∀ (u : ℕ) (w : G.Walk u i), G.Reachable a u → G'.Reachable u i from
    h' a w₀ (SimpleGraph.Reachable.refl a)
  clear w₀
  intro u w
  induction w with
  | nil => exact fun _ => SimpleGraph.Reachable.refl _
  | cons hadj w' ih =>
    intro hu
    exact (h _ _ hu hadj).reachable.trans (ih (hu.trans hadj.reachable))

/-- A set closed under the adjacency of `G` contains everything reachable from its points. -/
theorem mem_of_reachable_of_closed {G : SimpleGraph ℕ} {S : Finset ℕ}
    (hS : ∀ u v, G.Adj u v → u ∈ S → v ∈ S) {a i : ℕ} (ha : a ∈ S) (h : G.Reachable a i) :
    i ∈ S :=
  Resummation.of_reachable_of_closed (p := (· ∈ S)) hS h ha

/-! ### Pairs of a subpartition -/

section Subpartition

variable {X : Finset (Finset ℕ)}

theorem intraPairs_subset_pairsOn : intraPairs X ⊆ pairsOn (X.biUnion id) := by
  intro p hp
  obtain ⟨B, hB, hpB⟩ := mem_intraPairs.1 hp
  exact pairsOn_mono (subset_biUnion_of_mem hB) hpB

theorem interPairs_subset_pairsOn : interPairs X ⊆ pairsOn (X.biUnion id) :=
  Finset.sdiff_subset

theorem disjoint_interPairs_intraPairs : Disjoint (interPairs X) (intraPairs X) :=
  Finset.sdiff_disjoint

/-- The two endpoints of an inter-block pair lie in distinct blocks. -/
theorem exists_of_mem_interPairs {p : ℕ × ℕ} (hp : p ∈ interPairs X) :
    ∃ B ∈ X, ∃ B' ∈ X, B ≠ B' ∧ p.1 ∈ B ∧ p.2 ∈ B' := by
  rw [mem_interPairs, mem_pairsOn] at hp
  obtain ⟨⟨h1, h2, h12⟩, hn⟩ := hp
  obtain ⟨B, hB, h1B⟩ := mem_biUnion_id.1 h1
  obtain ⟨B', hB', h2B'⟩ := mem_biUnion_id.1 h2
  refine ⟨B, hB, B', hB', fun h => hn ⟨B, hB, mem_pairsOn.2 ⟨h1B, h ▸ h2B', h12⟩⟩, h1B, h2B'⟩

theorem mem_interPairs_of (hX : IsSubpartition X) {B B' : Finset ℕ} (hB : B ∈ X) (hB' : B' ∈ X)
    (hBB' : B ≠ B') {p : ℕ × ℕ} (h1 : p.1 ∈ B) (h2 : p.2 ∈ B') (h12 : p.1 < p.2) :
    p ∈ interPairs X := by
  rw [mem_interPairs, mem_pairsOn]
  refine ⟨⟨subset_biUnion_of_mem hB h1, subset_biUnion_of_mem hB' h2, h12⟩, ?_⟩
  rintro ⟨B'', hB'', hp⟩
  rw [mem_pairsOn] at hp
  exact hBB' ((eq_of_isSubpartition hX hB hB'' h1 hp.1).trans
    (eq_of_isSubpartition hX hB' hB'' h2 hp.2.1).symm)

/-- The union of the blocks of a subfamily and of its complement are disjoint. -/
theorem disjoint_biUnion_sdiff (hX : IsSubpartition X) {Y : Finset (Finset ℕ)} (hY : Y ⊆ X) :
    Disjoint (Y.biUnion id) ((X \ Y).biUnion id) := by
  rw [Finset.disjoint_left]
  intro x hx hx'
  obtain ⟨B, hB, hxB⟩ := mem_biUnion_id.1 hx
  obtain ⟨B', hB', hxB'⟩ := mem_biUnion_id.1 hx'
  rw [Finset.mem_sdiff] at hB'
  exact hB'.2 (eq_of_isSubpartition hX (hY hB) hB'.1 hxB hxB' ▸ hB)

theorem interPairs_subset_of_subset (hX : IsSubpartition X) {Y : Finset (Finset ℕ)} (hY : Y ⊆ X) :
    interPairs Y ⊆ interPairs X := by
  intro p hp
  obtain ⟨B, hB, B', hB', hBB', h1, h2⟩ := exists_of_mem_interPairs hp
  exact mem_interPairs_of hX (hY hB) (hY hB') hBB' h1 h2
    (mem_pairsOn.1 (interPairs_subset_pairsOn hp)).2.2

theorem disjoint_interPairs_sdiff (hX : IsSubpartition X) {Y : Finset (Finset ℕ)} (hY : Y ⊆ X) :
    Disjoint (interPairs Y) (interPairs (X \ Y)) := by
  rw [Finset.disjoint_left]
  intro p hp hp'
  have h1 := (mem_pairsOn.1 (interPairs_subset_pairsOn hp)).1
  have h1' := (mem_pairsOn.1 (interPairs_subset_pairsOn hp')).1
  exact Finset.disjoint_left.1 (disjoint_biUnion_sdiff hX hY) h1 h1'

end Subpartition

/-! ### The blocks reached from a block -/

section Reach

variable {X : Finset (Finset ℕ)}

open scoped Classical in
/-- The blocks of `X` reached from the point `a` in `E ∪ ℰ^intra(X)`. -/
noncomputable def reachedBlocks (X : Finset (Finset ℕ)) (E : Finset (ℕ × ℕ)) (a : ℕ) :
    Finset (Finset ℕ) :=
  X.filter fun B => ∃ i ∈ B, (edgeGraph (E ∪ intraPairs X)).Reachable a i

/-- Two points of a block are joined by the intra-block pairs. -/
theorem reachable_of_mem_block {B : Finset ℕ} (hB : B ∈ X) (F : Finset (ℕ × ℕ)) {i j : ℕ}
    (hi : i ∈ B) (hj : j ∈ B) : (edgeGraph (F ∪ intraPairs X)).Reachable i j := by
  rcases lt_trichotomy i j with h | rfl | h
  · refine SimpleGraph.Adj.reachable (edgeGraph_adj.2 ⟨h.ne, Or.inl ?_⟩)
    exact Finset.mem_union_right _ (mem_intraPairs.2 ⟨B, hB, mem_pairsOn.2 ⟨hi, hj, h⟩⟩)
  · exact SimpleGraph.Reachable.refl _
  · refine SimpleGraph.Adj.reachable (edgeGraph_adj.2 ⟨h.ne', Or.inr ?_⟩)
    exact Finset.mem_union_right _ (mem_intraPairs.2 ⟨B, hB, mem_pairsOn.2 ⟨hj, hi, h⟩⟩)

/-- **Characterization of the reached blocks.** For `E ⊆ ℰ^inter(X)` and `a ∈ B₀ ∈ Y ⊆ X`, the
blocks reached from `a` are `Y` iff no pair of `E` joins `V_Y` to `V_{X \ Y}` and
`(E ∩ ℰ^inter(Y)) ∪ ℰ^intra(Y)` connects `V_Y`. -/
theorem reachedBlocks_eq_iff (hX : IsSubpartition X) {E : Finset (ℕ × ℕ)}
    (hE : E ⊆ interPairs X) {Y : Finset (Finset ℕ)} (hY : Y ⊆ X) {B₀ : Finset ℕ} (hB₀ : B₀ ∈ Y)
    {a : ℕ} (ha : a ∈ B₀) :
    reachedBlocks X E a = Y ↔
      E ⊆ interPairs Y ∪ interPairs (X \ Y) ∧
        ConnOn (Y.biUnion id) (E ∩ interPairs Y ∪ intraPairs Y) := by
  classical
  set G := edgeGraph (E ∪ intraPairs X) with hG
  have hEX : E ∪ intraPairs X ⊆ pairsOn (X.biUnion id) :=
    Finset.union_subset (hE.trans interPairs_subset_pairsOn) intraPairs_subset_pairsOn
  have haX : a ∈ X.biUnion id := subset_biUnion_of_mem (hY hB₀) ha
  have haY : a ∈ Y.biUnion id := subset_biUnion_of_mem hB₀ ha
  -- membership of a point of `V_X` in the reached blocks
  have hreach : ∀ B ∈ X, ∀ i ∈ B, (B ∈ reachedBlocks X E a ↔ G.Reachable a i) := by
    intro B hB i hi
    simp only [reachedBlocks, Finset.mem_filter, hB, true_and]
    constructor
    · rintro ⟨j, hj, hreach⟩
      exact hreach.trans (reachable_of_mem_block hB E hj hi)
    · intro h
      exact ⟨i, hi, h⟩
  -- an inter-block pair inside `V_Y` is in `ℰ^inter(Y)`
  have hinterY : ∀ p ∈ interPairs X, p.1 ∈ Y.biUnion id → p.2 ∈ Y.biUnion id →
      p ∈ interPairs Y := by
    intro p hp h1 h2
    obtain ⟨B, hB, B', hB', hBB', h1B, h2B'⟩ := exists_of_mem_interPairs hp
    obtain ⟨C, hC, h1C⟩ := mem_biUnion_id.1 h1
    obtain ⟨C', hC', h2C'⟩ := mem_biUnion_id.1 h2
    rw [← eq_of_isSubpartition hX (hY hC) hB h1C h1B] at hBB'
    rw [← eq_of_isSubpartition hX (hY hC') hB' h2C' h2B'] at hBB'
    exact mem_interPairs_of (isSubpartition_mono hX hY) hC hC' hBB' h1C h2C'
      (mem_pairsOn.1 (interPairs_subset_pairsOn hp)).2.2
  have hinterXY : ∀ p ∈ interPairs X, p.1 ∈ (X \ Y).biUnion id → p.2 ∈ (X \ Y).biUnion id →
      p ∈ interPairs (X \ Y) := by
    intro p hp h1 h2
    obtain ⟨B, hB, B', hB', hBB', h1B, h2B'⟩ := exists_of_mem_interPairs hp
    obtain ⟨C, hC, h1C⟩ := mem_biUnion_id.1 h1
    obtain ⟨C', hC', h2C'⟩ := mem_biUnion_id.1 h2
    have hC1 := (Finset.mem_sdiff.1 hC).1
    have hC'1 := (Finset.mem_sdiff.1 hC').1
    rw [← eq_of_isSubpartition hX hC1 hB h1C h1B] at hBB'
    rw [← eq_of_isSubpartition hX hC'1 hB' h2C' h2B'] at hBB'
    exact mem_interPairs_of (isSubpartition_mono hX Finset.sdiff_subset) hC hC' hBB' h1C h2C'
      (mem_pairsOn.1 (interPairs_subset_pairsOn hp)).2.2
  -- points of `V_X` are in `V_Y` or in `V_{X \ Y}`
  have hsplit : ∀ i ∈ X.biUnion id, i ∈ Y.biUnion id ∨ i ∈ (X \ Y).biUnion id := by
    intro i hi
    obtain ⟨B, hB, hiB⟩ := mem_biUnion_id.1 hi
    by_cases hBY : B ∈ Y
    · exact Or.inl (subset_biUnion_of_mem hBY hiB)
    · exact Or.inr (subset_biUnion_of_mem (Finset.mem_sdiff.2 ⟨hB, hBY⟩) hiB)
  have hdisj := disjoint_biUnion_sdiff hX hY
  constructor
  · intro hR
    -- reachable points of `V_X` are the points of `V_Y`
    have hRY : ∀ i ∈ X.biUnion id, (G.Reachable a i ↔ i ∈ Y.biUnion id) := by
      intro i hi
      obtain ⟨B, hB, hiB⟩ := mem_biUnion_id.1 hi
      rw [← hreach B hB i hiB, hR]
      constructor
      · intro hBY
        exact subset_biUnion_of_mem hBY hiB
      · intro hiY
        obtain ⟨C, hC, hiC⟩ := mem_biUnion_id.1 hiY
        exact eq_of_isSubpartition hX (hY hC) hB hiC hiB ▸ hC
    -- every reachable point lies in `V_X`
    have hRX : ∀ i, G.Reachable a i → i ∈ X.biUnion id := fun i hi =>
      mem_of_reachable_of_closed (fun u v huv _ => (mem_of_edgeGraph_adj hEX huv).2) haX hi
    refine ⟨fun p hp => ?_, ⟨⟨a, haY⟩, fun i hi j hj => ?_⟩⟩
    · have hpX := hE hp
      have hp1 := (mem_pairsOn.1 (interPairs_subset_pairsOn hpX)).1
      have hp2 := (mem_pairsOn.1 (interPairs_subset_pairsOn hpX)).2.1
      have hadj : G.Adj p.1 p.2 :=
        edgeGraph_adj.2 ⟨(mem_pairsOn.1 (interPairs_subset_pairsOn hpX)).2.2.ne,
          Or.inl (Finset.mem_union_left _ hp)⟩
      rcases hsplit _ hp1 with h1 | h1
      · have hr2 : G.Reachable a p.2 := ((hRY _ hp1).2 h1).trans hadj.reachable
        exact Finset.mem_union_left _ (hinterY p hpX h1 ((hRY _ hp2).1 hr2))
      · have h2 : p.2 ∈ (X \ Y).biUnion id := by
          rcases hsplit _ hp2 with h2 | h2
          · have hr1 : G.Reachable a p.1 := ((hRY _ hp2).2 h2).trans hadj.symm.reachable
            exact absurd ((hRY _ hp1).1 hr1) (Finset.disjoint_right.1 hdisj h1)
          · exact h2
        exact Finset.mem_union_right _ (hinterXY p hpX h1 h2)
    · -- transfer the walks from `a`
      have htrans : ∀ k, G.Reachable a k →
          (edgeGraph (E ∩ interPairs Y ∪ intraPairs Y)).Reachable a k := by
        intro k hk
        refine reachable_of_forall_adj_of_reachable (fun u v hu huv => ?_) hk
        have huY := (hRY u (hRX u hu)).1 hu
        have hvY := (hRY v (hRX v (hu.trans huv.reachable))).1 (hu.trans huv.reachable)
        rw [edgeGraph_adj] at huv ⊢
        refine ⟨huv.1, huv.2.imp (fun h => ?_) (fun h => ?_)⟩
        · rcases Finset.mem_union.1 h with h | h
          · exact Finset.mem_union_left _ (Finset.mem_inter.2 ⟨h, hinterY _ (hE h) huY hvY⟩)
          · obtain ⟨B, hB, hpB⟩ := mem_intraPairs.1 h
            obtain ⟨C, hC, huC⟩ := mem_biUnion_id.1 huY
            rw [eq_of_isSubpartition hX hB (hY hC) (mem_pairsOn.1 hpB).1 huC] at hpB
            exact Finset.mem_union_right _ (mem_intraPairs.2 ⟨C, hC, hpB⟩)
        · rcases Finset.mem_union.1 h with h | h
          · exact Finset.mem_union_left _ (Finset.mem_inter.2 ⟨h, hinterY _ (hE h) hvY huY⟩)
          · obtain ⟨B, hB, hpB⟩ := mem_intraPairs.1 h
            obtain ⟨C, hC, hvC⟩ := mem_biUnion_id.1 hvY
            rw [eq_of_isSubpartition hX hB (hY hC) (mem_pairsOn.1 hpB).1 hvC] at hpB
            exact Finset.mem_union_right _ (mem_intraPairs.2 ⟨C, hC, hpB⟩)
      have hiX := (Finset.biUnion_subset_biUnion_of_subset_left id hY) hi
      have hjX := (Finset.biUnion_subset_biUnion_of_subset_left id hY) hj
      exact (htrans i ((hRY i hiX).2 hi)).symm.trans (htrans j ((hRY j hjX).2 hj))
  · rintro ⟨hEsplit, hconn⟩
    -- `V_Y` is closed in `G`
    have hclosed : ∀ u v, G.Adj u v → u ∈ Y.biUnion id → v ∈ Y.biUnion id := by
      intro u v huv hu
      have hpair : ∀ q ∈ E ∪ intraPairs X, (q.1 = u ∧ q.2 = v) ∨ (q.1 = v ∧ q.2 = u) →
          v ∈ Y.biUnion id := by
        intro q hq hquv
        rcases Finset.mem_union.1 hq with hq | hq
        · rcases Finset.mem_union.1 (hEsplit hq) with hq' | hq'
          · have := mem_pairsOn.1 (interPairs_subset_pairsOn hq')
            rcases hquv with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
            exacts [this.2.1, this.1]
          · have := mem_pairsOn.1 (interPairs_subset_pairsOn hq')
            rcases hquv with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
            · exact absurd this.1 (Finset.disjoint_left.1 hdisj hu)
            · exact absurd this.2.1 (Finset.disjoint_left.1 hdisj hu)
        · obtain ⟨B, hB, hqB⟩ := mem_intraPairs.1 hq
          obtain ⟨C, hC, huC⟩ := mem_biUnion_id.1 hu
          have hq' := mem_pairsOn.1 hqB
          rcases hquv with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
          · rw [eq_of_isSubpartition hX hB (hY hC) hq'.1 huC] at hq'
            exact subset_biUnion_of_mem hC hq'.2.1
          · rw [eq_of_isSubpartition hX hB (hY hC) hq'.2.1 huC] at hq'
            exact subset_biUnion_of_mem hC hq'.1
      rcases exists_mem_of_edgeGraph_adj huv with h | h
      · exact hpair _ h (Or.inl ⟨rfl, rfl⟩)
      · exact hpair _ h (Or.inr ⟨rfl, rfl⟩)
    have hsub : edgeGraph (E ∩ interPairs Y ∪ intraPairs Y) ≤ G := by
      refine edgeGraph_mono (Finset.union_subset_union Finset.inter_subset_left ?_)
      intro p hp
      obtain ⟨B, hB, hpB⟩ := mem_intraPairs.1 hp
      exact mem_intraPairs.2 ⟨B, hY hB, hpB⟩
    ext B
    constructor
    · intro hB
      rw [reachedBlocks, Finset.mem_filter] at hB
      obtain ⟨i, hi, hreachi⟩ := hB.2
      have hiY := mem_of_reachable_of_closed hclosed haY hreachi
      obtain ⟨C, hC, hiC⟩ := mem_biUnion_id.1 hiY
      rw [eq_of_isSubpartition hX hB.1 (hY hC) hi hiC]
      exact hC
    · intro hB
      obtain ⟨i, hi⟩ := (isSubpartition_mono hX hY).1 B hB
      rw [hreach B (hY hB) i hi]
      exact (hconn.2 a haY i (subset_biUnion_of_mem hB hi)).mono hsub

theorem mem_reachedBlocks_self {E : Finset (ℕ × ℕ)} {B₀ : Finset ℕ}
    (hB₀ : B₀ ∈ X) {a : ℕ} (ha : a ∈ B₀) : B₀ ∈ reachedBlocks X E a := by
  classical
  rw [reachedBlocks, Finset.mem_filter]
  exact ⟨hB₀, a, ha, SimpleGraph.Reachable.refl _⟩

end Reach

/-! ### The root-component expansion -/

section Expansion

variable {X : Finset (Finset ℕ)}

open scoped Classical in
/-- **Root-component expansion.** Group the edge sets `E ⊆ ℰ^inter(X)` by the set `Y ∋ B₀` of
blocks reached from `B₀` in `E ∪ ℰ^intra(X)`: `E` splits into an edge set of `𝖤'(Y)` (connecting
`V_Y` together with `ℰ^intra(Y)`) and an arbitrary edge set on `X \ Y`. -/
theorem sum_powerset_interPairs_root {R : Type*} [CommSemiring R] (hX : IsSubpartition X)
    {B₀ : Finset ℕ} (hB₀ : B₀ ∈ X) (g : ℕ × ℕ → R) :
    ∑ E ∈ (interPairs X).powerset, ∏ p ∈ E, g p =
      ∑ Y ∈ X.powerset.filter (B₀ ∈ ·),
        (∑ E ∈ (interPairs Y).powerset.filter
            (fun E => ConnOn (Y.biUnion id) (E ∪ intraPairs Y)), ∏ p ∈ E, g p) *
          ∑ E ∈ (interPairs (X \ Y)).powerset, ∏ p ∈ E, g p := by
  obtain ⟨a, ha⟩ := hX.1 B₀ hB₀
  rw [← Finset.sum_fiberwise_of_maps_to (g := fun E => reachedBlocks X E a)
    (t := X.powerset.filter (B₀ ∈ ·)) (fun E _ => ?_)]
  · refine Finset.sum_congr rfl fun Y hY => ?_
    rw [Finset.mem_filter, Finset.mem_powerset] at hY
    have hYs := isSubpartition_mono hX hY.1
    have hXYs := isSubpartition_mono hX (Finset.sdiff_subset (s := X) (t := Y))
    have hdisj := disjoint_interPairs_sdiff hX hY.1
    rw [Finset.sum_mul_sum, ← Finset.sum_product']
    refine Finset.sum_nbij' (fun E => (E ∩ interPairs Y, E ∩ interPairs (X \ Y)))
      (fun q => q.1 ∪ q.2) ?_ ?_ ?_ ?_ ?_
    · intro E hE
      rw [Finset.mem_filter, Finset.mem_powerset] at hE
      obtain ⟨-, hconn⟩ := (reachedBlocks_eq_iff hX hE.1 hY.1 hY.2 ha).1 hE.2
      rw [Finset.mem_product, Finset.mem_filter, Finset.mem_powerset, Finset.mem_powerset]
      exact ⟨⟨Finset.inter_subset_right, hconn⟩, Finset.inter_subset_right⟩
    · rintro ⟨E₁, E₂⟩ hq
      rw [Finset.mem_product, Finset.mem_filter, Finset.mem_powerset, Finset.mem_powerset] at hq
      have hsub : E₁ ∪ E₂ ⊆ interPairs X := Finset.union_subset
        (hq.1.1.trans (interPairs_subset_of_subset hX hY.1))
        (hq.2.trans (interPairs_subset_of_subset hX Finset.sdiff_subset))
      rw [Finset.mem_filter, Finset.mem_powerset]
      refine ⟨hsub, (reachedBlocks_eq_iff hX hsub hY.1 hY.2 ha).2 ⟨Finset.union_subset_union
        hq.1.1 hq.2, ?_⟩⟩
      have : (E₁ ∪ E₂) ∩ interPairs Y = E₁ := by
        rw [Finset.union_inter_distrib_right, Finset.inter_eq_left.2 hq.1.1,
          Finset.disjoint_iff_inter_eq_empty.1 (hdisj.symm.mono_left hq.2), Finset.union_empty]
      rw [this]
      exact hq.1.2
    · intro E hE
      rw [Finset.mem_filter, Finset.mem_powerset] at hE
      obtain ⟨hsplit, -⟩ := (reachedBlocks_eq_iff hX hE.1 hY.1 hY.2 ha).1 hE.2
      simp only
      rw [← Finset.inter_union_distrib_left, Finset.inter_eq_left.2 hsplit]
    · rintro ⟨E₁, E₂⟩ hq
      rw [Finset.mem_product, Finset.mem_filter, Finset.mem_powerset, Finset.mem_powerset] at hq
      simp only [Prod.mk.injEq]
      constructor
      · rw [Finset.union_inter_distrib_right, Finset.inter_eq_left.2 hq.1.1,
          Finset.disjoint_iff_inter_eq_empty.1 (hdisj.symm.mono_left hq.2), Finset.union_empty]
      · rw [Finset.union_inter_distrib_right, Finset.inter_eq_left.2 hq.2,
          Finset.disjoint_iff_inter_eq_empty.1 (hdisj.mono_left hq.1.1), Finset.empty_union]
    · intro E hE
      rw [Finset.mem_filter, Finset.mem_powerset] at hE
      obtain ⟨hsplit, -⟩ := (reachedBlocks_eq_iff hX hE.1 hY.1 hY.2 ha).1 hE.2
      simp only
      rw [← Finset.prod_union (hdisj.mono Finset.inter_subset_right Finset.inter_subset_right),
        ← Finset.inter_union_distrib_left, Finset.inter_eq_left.2 hsplit]
  · rw [Finset.mem_filter, Finset.mem_powerset]
    exact ⟨Finset.filter_subset _ _, mem_reachedBlocks_self hB₀ ha⟩

end Expansion

/-! ### Pairs of a disjoint union -/

section Union

variable {C D : Finset ℕ}

theorem pairsOn_union (C D : Finset ℕ) :
    pairsOn (C ∪ D) = pairsOn C ∪ pairsOn D ∪ crossPairs C D := by
  ext p
  simp only [Finset.mem_union, mem_pairsOn, mem_crossPairs]
  constructor
  · rintro ⟨h1 | h1, h2 | h2, h12⟩ <;> tauto
  · rintro ((⟨h1, h2, h12⟩ | ⟨h1, h2, h12⟩) | ⟨(⟨h1, h2⟩ | ⟨h1, h2⟩), h12⟩) <;> tauto

theorem disjoint_pairsOn_pairsOn (h : Disjoint C D) : Disjoint (pairsOn C) (pairsOn D) := by
  rw [Finset.disjoint_left]
  intro p hp hp'
  exact Finset.disjoint_left.1 h (mem_pairsOn.1 hp).1 (mem_pairsOn.1 hp').1

theorem disjoint_pairsOn_crossPairs (h : Disjoint C D) : Disjoint (pairsOn C) (crossPairs C D) := by
  rw [Finset.disjoint_left]
  intro p hp hp'
  rw [mem_pairsOn] at hp
  rw [mem_crossPairs] at hp'
  rcases hp'.1 with h' | h'
  · exact Finset.disjoint_left.1 h hp.2.1 h'.2
  · exact Finset.disjoint_left.1 h hp.1 h'.1

theorem disjoint_pairsOn_crossPairs' (h : Disjoint C D) :
    Disjoint (pairsOn D) (crossPairs C D) := by
  rw [Finset.disjoint_left]
  intro p hp hp'
  rw [mem_pairsOn] at hp
  rw [mem_crossPairs] at hp'
  rcases hp'.1 with h' | h'
  · exact Finset.disjoint_left.1 h h'.1 hp.1
  · exact Finset.disjoint_left.1 h h'.2 hp.2.1

theorem prod_pairsOn_union {M : Type*} [CommMonoid M] (h : Disjoint C D) (f : ℕ × ℕ → M) :
    ∏ p ∈ pairsOn (C ∪ D), f p =
      (∏ p ∈ pairsOn C, f p) * (∏ p ∈ pairsOn D, f p) * ∏ p ∈ crossPairs C D, f p := by
  rw [pairsOn_union, Finset.prod_union, Finset.prod_union (disjoint_pairsOn_pairsOn h)]
  exact Finset.disjoint_union_left.2 ⟨disjoint_pairsOn_crossPairs h, disjoint_pairsOn_crossPairs' h⟩

/-- The inter-block pairs of `{B} ∪ σ`, for a partition `σ` of `U \ B`, are those of `σ` and the
pairs between `B` and `U \ B`. -/
theorem interPairs_insert {U B : Finset ℕ} {σ : Finset (Finset ℕ)} (hBU : B ⊆ U)
    (hσ : σ ∈ partitions (U \ B)) (hB : B.Nonempty) :
    interPairs (insert B σ) = interPairs σ ∪ crossPairs B (U \ B) := by
  have hins := insert_mem_partitions hBU hB hσ
  have hU : (insert B σ).biUnion id = U := (mem_partitions.1 hins).2
  have hσU : σ.biUnion id = U \ B := (mem_partitions.1 hσ).2
  have hd : Disjoint B (U \ B) := Finset.disjoint_sdiff
  ext p
  rw [Finset.mem_union, mem_interPairs, mem_interPairs, hU, hσU]
  conv_lhs => rw [← Finset.union_sdiff_of_subset hBU]
  rw [pairsOn_union]
  simp only [Finset.mem_union, Finset.mem_insert, exists_eq_or_imp]
  constructor
  · rintro ⟨(h1 | h1) | h1, h2⟩
    · exact absurd h1 (not_or.1 h2).1
    · exact Or.inl ⟨h1, (not_or.1 h2).2⟩
    · exact Or.inr h1
  · rintro (⟨h1, h2⟩ | h1)
    · refine ⟨Or.inl (Or.inr h1), not_or.2 ⟨fun hB' => ?_, h2⟩⟩
      exact Finset.disjoint_left.1 (disjoint_pairsOn_pairsOn hd) hB' h1
    · refine ⟨Or.inr h1, not_or.2 ⟨fun hB' => ?_, ?_⟩⟩
      · exact Finset.disjoint_left.1 (disjoint_pairsOn_crossPairs hd) hB' h1
      · rintro ⟨B', hB', hp⟩
        have hB'U := subset_of_mem_partitions hσ hB'
        exact Finset.disjoint_left.1 (disjoint_pairsOn_crossPairs' hd) (pairsOn_mono hB'U hp) h1

theorem disjoint_interPairs_crossPairs {U B : Finset ℕ} {σ : Finset (Finset ℕ)}
    (hσ : σ ∈ partitions (U \ B)) : Disjoint (interPairs σ) (crossPairs B (U \ B)) := by
  have hσU : σ.biUnion id = U \ B := (mem_partitions.1 hσ).2
  refine Finset.disjoint_of_subset_left interPairs_subset_pairsOn ?_
  rw [hσU]
  exact disjoint_pairsOn_crossPairs' Finset.disjoint_sdiff

end Union

/-! ### Singleton blocks -/

section Singletons

/-- The partition of `V` into singletons. -/
def singletons (V : Finset ℕ) : Finset (Finset ℕ) :=
  V.image singleton

theorem isSubpartition_singletons (V : Finset ℕ) : IsSubpartition (singletons V) :=
  isSubpartition_image_singleton V

theorem biUnion_singletons (V : Finset ℕ) : (singletons V).biUnion id = V :=
  biUnion_image_singleton V

theorem pairsOn_singleton (i : ℕ) : pairsOn {i} = ∅ := by
  ext p
  simp only [mem_pairsOn, Finset.mem_singleton, Finset.notMem_empty, iff_false]
  rintro ⟨h1, h2, h12⟩
  omega

theorem intraPairs_singletons (V : Finset ℕ) : intraPairs (singletons V) = ∅ := by
  ext p
  simp only [mem_intraPairs, singletons, Finset.mem_image, Finset.notMem_empty, iff_false]
  rintro ⟨B, ⟨i, -, rfl⟩, hp⟩
  rw [pairsOn_singleton] at hp
  exact Finset.notMem_empty p hp

theorem interPairs_singletons (V : Finset ℕ) : interPairs (singletons V) = pairsOn V := by
  rw [interPairs, intraPairs_singletons, Finset.sdiff_empty, biUnion_singletons]

theorem singletons_sdiff (V D : Finset ℕ) :
    singletons V \ singletons D = singletons (V \ D) := by
  ext B
  simp only [singletons, Finset.mem_sdiff, Finset.mem_image]
  constructor
  · rintro ⟨⟨i, hi, rfl⟩, h⟩
    exact ⟨i, ⟨hi, fun hiD => h ⟨i, hiD, rfl⟩⟩, rfl⟩
  · rintro ⟨i, ⟨hi, hiD⟩, rfl⟩
    refine ⟨⟨i, hi, rfl⟩, ?_⟩
    rintro ⟨j, hj, hji⟩
    rw [Finset.singleton_inj.1 hji] at hj
    exact hiD hj

theorem singletons_biUnion_of_subset {V : Finset ℕ} {Y : Finset (Finset ℕ)}
    (hY : Y ⊆ singletons V) : singletons (Y.biUnion id) = Y := by
  ext B
  simp only [singletons, Finset.mem_image, mem_biUnion_id]
  constructor
  · rintro ⟨i, ⟨B', hB', hiB'⟩, rfl⟩
    obtain ⟨j, -, rfl⟩ := Finset.mem_image.1 (hY hB')
    rw [Finset.mem_singleton.1 hiB']
    exact hB'
  · intro hB
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.1 (hY hB)
    exact ⟨i, ⟨{i}, hB, Finset.mem_singleton_self i⟩, rfl⟩

theorem singletons_mono {D V : Finset ℕ} (h : D ⊆ V) : singletons D ⊆ singletons V :=
  Finset.image_subset_image h

theorem singleton_mem_singletons {V : Finset ℕ} {a : ℕ} : {a} ∈ singletons V ↔ a ∈ V := by
  simp [singletons]

/-- Subfamilies of the singletons of `V` containing `{a}` are the singletons of the subsets of
`V` containing `a`. -/
theorem sum_powerset_singletons {M : Type*} [AddCommMonoid M] (V : Finset ℕ) (a : ℕ)
    (F : Finset (Finset ℕ) → M) :
    ∑ Y ∈ (singletons V).powerset.filter (({a} : Finset ℕ) ∈ ·), F Y =
      ∑ D ∈ V.powerset.filter (a ∈ ·), F (singletons D) := by
  refine Finset.sum_nbij' (fun Y => Y.biUnion id) singletons ?_ ?_ ?_ ?_ ?_
  · intro Y hY
    rw [Finset.mem_filter, Finset.mem_powerset] at hY ⊢
    refine ⟨fun i hi => ?_, subset_biUnion_of_mem hY.2 (Finset.mem_singleton_self a)⟩
    obtain ⟨B, hB, hiB⟩ := mem_biUnion_id.1 hi
    have := hY.1 hB
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.1 this
    rw [Finset.mem_singleton.1 hiB]
    exact hj
  · intro D hD
    rw [Finset.mem_filter, Finset.mem_powerset] at hD ⊢
    exact ⟨singletons_mono hD.1, singleton_mem_singletons.2 hD.2⟩
  · intro Y hY
    exact singletons_biUnion_of_subset (Finset.mem_powerset.1 (Finset.mem_filter.1 hY).1)
  · intro D _
    exact biUnion_singletons D
  · intro Y hY
    rw [singletons_biUnion_of_subset (Finset.mem_powerset.1 (Finset.mem_filter.1 hY).1)]

open scoped Classical in
/-- **Mayer expansion grouped by the component of a point.** -/
theorem sum_powerset_pairsOn_root {R : Type*} [CommSemiring R] {V : Finset ℕ} {a : ℕ}
    (ha : a ∈ V) (g : ℕ × ℕ → R) :
    ∑ E ∈ (pairsOn V).powerset, ∏ p ∈ E, g p =
      ∑ D ∈ V.powerset.filter (a ∈ ·),
        (∑ E ∈ (pairsOn D).powerset.filter (ConnOn D), ∏ p ∈ E, g p) *
          ∑ E ∈ (pairsOn (V \ D)).powerset, ∏ p ∈ E, g p := by
  have h := sum_powerset_interPairs_root (isSubpartition_singletons V)
    (singleton_mem_singletons.2 ha) g
  rw [interPairs_singletons, sum_powerset_singletons] at h
  rw [h]
  refine Finset.sum_congr rfl fun D _ => ?_
  rw [interPairs_singletons, biUnion_singletons, intraPairs_singletons, singletons_sdiff,
    interPairs_singletons]
  simp only [Finset.union_empty]

open scoped Classical in
/-- **Exactly one component contains `a`.** For an edge set `L` on `U` and `a ∈ U`, exactly one
`D ∋ a` is connected by `L` and has no pair of `L` leaving it. -/
theorem sum_conn_crossPairs_eq_one {R : Type*} [AddCommMonoidWithOne R] {U : Finset ℕ} {a : ℕ}
    (ha : a ∈ U) {L : Finset (ℕ × ℕ)} (hL : L ⊆ pairsOn U) :
    ∑ D ∈ U.powerset.filter (a ∈ ·),
      (if ConnOn D (L ∩ pairsOn D) ∧ Disjoint L (crossPairs D (U \ D)) then (1 : R) else 0) =
        1 := by
  have hX := isSubpartition_singletons U
  have hLX : L ⊆ interPairs (singletons U) := by rwa [interPairs_singletons]
  have hiff : ∀ D ∈ U.powerset.filter (a ∈ ·),
      (ConnOn D (L ∩ pairsOn D) ∧ Disjoint L (crossPairs D (U \ D))) ↔
        reachedBlocks (singletons U) L a = singletons D := by
    intro D hD
    rw [Finset.mem_filter, Finset.mem_powerset] at hD
    rw [reachedBlocks_eq_iff hX hLX (singletons_mono hD.1) (singleton_mem_singletons.2 hD.2)
      (Finset.mem_singleton_self a), singletons_sdiff, interPairs_singletons,
      interPairs_singletons, biUnion_singletons, intraPairs_singletons, Finset.union_empty]
    have hsplit : L ⊆ pairsOn D ∪ pairsOn (U \ D) ↔ Disjoint L (crossPairs D (U \ D)) := by
      have hU : pairsOn U = pairsOn D ∪ pairsOn (U \ D) ∪ crossPairs D (U \ D) := by
        rw [← pairsOn_union, Finset.union_sdiff_of_subset hD.1]
      constructor
      · intro h
        exact Finset.disjoint_of_subset_left h (Finset.disjoint_union_left.2
          ⟨disjoint_pairsOn_crossPairs Finset.disjoint_sdiff,
            disjoint_pairsOn_crossPairs' Finset.disjoint_sdiff⟩)
      · intro h p hp
        have := hL hp
        rw [hU, Finset.mem_union] at this
        rcases this with h' | h'
        · exact h'
        · exact absurd h' (Finset.disjoint_left.1 h hp)
    rw [hsplit]
    exact and_comm
  rw [Finset.sum_congr rfl fun D hD => by rw [if_congr (hiff D hD) rfl rfl]]
  set Y := reachedBlocks (singletons U) L a with hYdef
  have hYsub : Y ⊆ singletons U := Finset.filter_subset _ _
  have haY : {a} ∈ Y := mem_reachedBlocks_self (singleton_mem_singletons.2 ha)
    (Finset.mem_singleton_self a)
  rw [Finset.sum_eq_single (Y.biUnion id)]
  · rw [singletons_biUnion_of_subset hYsub, ite_eq_left rfl]
  · intro D hD hne
    rw [ite_eq_right]
    intro h
    apply hne
    rw [h, biUnion_singletons]
  · intro hnot
    exfalso
    apply hnot
    rw [Finset.mem_filter, Finset.mem_powerset]
    refine ⟨fun i hi => ?_, subset_biUnion_of_mem haY (Finset.mem_singleton_self a)⟩
    rw [← biUnion_singletons U]
    exact Finset.biUnion_subset_biUnion_of_subset_left id hYsub hi

end Singletons

end Multipole

end MultipoleBKT


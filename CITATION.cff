    given-names: Jeanne
  - family-names: Serfaty
    given-names: Sylvia
keywords:
  - Lean
  - mathlib
  - formal verification
  - two-component plasma
  - Coulomb gas
  - Berezinskii-Kosterlitz-Thouless transition
  - multipoles
  - large deviations
